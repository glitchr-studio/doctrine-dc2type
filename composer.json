{
  "name": "glitchr/doctrine-dc2type",
  "type": "composer-plugin",
  "description": "Plugin re-enabling DC2Type comments in Doctrine DBAL",
  "keywords": [
    "symfony",
    "doctrine",
    "dc2type"
  ],
  "homepage": "https://github.com/glitchr-studio/doctrine-dc2type",
  "license": "LGPL-3.0-or-later",
  "authors": [
    {
      "name": "Marco Meyer",
      "email": "marco.meyer@glitchr.io"
    }
  ],
  "require": {
    "php": "^8.0",
    "composer-plugin-api": "^2.0"
  },
  "require-dev": {
    "composer/composer": "^2.0",
    "phpunit/phpunit": "^9.5|^10.0"
  },
  "autoload": {
    "psr-4": {
      "Doctrine\\Composer\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Doctrine\\Composer\\Tests\\": "tests"
    }
  },
  "config": {
    "platform": {
      "php": "8.0"
    },
    "preferred-install": {
      "*": "dist"
    },
    "sort-packages": true
  },
  "scripts": {
    "test": "phpunit"
  },
  "extra": {
    "class": "Doctrine\\Composer\\Plugin"
  }
}
